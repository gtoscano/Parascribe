# Copy this file to `.env` and fill in your token, then start the service.
#
# A Hugging Face token is required for speaker diarization (the pyannote models).
# Without it the service still transcribes, but every speaker comes back as
# "Speaker ?".
#
#   1. Create a token:  https://huggingface.co/settings/tokens
#   2. Accept the model licenses once, while logged in:
#        https://huggingface.co/pyannote/speaker-diarization-3.1
#        https://huggingface.co/pyannote/segmentation-3.0
#
HUGGINGFACE_HUB_TOKEN=
